# Stripe
STRIPE_SECRET_KEY=sk_live_...           # from Stripe dashboard → Developers → API keys
STRIPE_WEBHOOK_SECRET=whsec_...         # from Stripe dashboard → Webhooks → signing secret

# Stripe Price IDs — create these in Stripe dashboard → Products
STRIPE_PRICE_BUYER_PER_RFQ=price_...    # $49 one-time
STRIPE_PRICE_BUYER_BUSINESS=price_...   # $199/mo recurring

STRIPE_PRICE_RESELLER_PER_BID=price_... # $9.99 one-time
STRIPE_PRICE_RESELLER_STARTER=price_... # $49/mo 10 bids recurring
STRIPE_PRICE_RESELLER_GROWTH=price_...  # $99/mo 25 bids recurring
STRIPE_PRICE_RESELLER_UNLIMITED=price_... # $149/mo unlimited recurring

# Supabase (auto-provided in Edge Function runtime — no need to set manually)
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
